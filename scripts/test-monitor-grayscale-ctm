#!/usr/bin/env bash
set -Eeuo pipefail

# Resolve the repository path even when launched through ~/.local/bin's symlink.
script_dir=$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")
if [[ ${1-} == --help || ${1-} == -h ]]; then
    cat <<'EOF'
Usage: test-monitor-grayscale-ctm [COMMAND] [--seconds N] [OUTPUT ...]

Try the main CTM grayscale implementation for 15 seconds, then restore the
original matrices. Enter, q, or Ctrl+C restores sooner in a terminal.

Examples:
  ./scripts/test-monitor-grayscale-ctm
  ./scripts/test-monitor-grayscale-ctm --seconds 30 HDMI-1

Explicit on, off, toggle, status, --status, and trial commands are also accepted.
See toggle-monitor-grayscale --help for the complete command reference.
EOF
    exit 0
fi
case ${1-} in
    trial|on|off|toggle|auto|status|--status) ;;
    *) set -- trial "$@" ;;
esac
exec "$script_dir/toggle-monitor-grayscale" "$@"
