+static void
+readxresources(void)
+{
+	char *resource_string, *type, *copy;
+	XrmDatabase database;
+	XrmValue value;
+
+	XrmInitialize();
+	if (!(resource_string = XResourceManagerString(dpy)))
+		return;
+	if (!(database = XrmGetStringDatabase(resource_string)))
+		return;
+
+	/* Keep copied values alive for the lifetime of dmenu. Defaults and
+	 * command line values are borrowed strings and must not be freed. */
+	if (XrmGetResource(database, "dmenu.font", "*", &type, &value)
+	&& !strcmp(type, "String") && value.addr) {
+		if (!(copy = strdup(value.addr)))
+			die("strdup:");
+		fonts[0] = copy;
+	}
+	if (XrmGetResource(database, "dmenu.background", "*", &type, &value)
+	&& !strcmp(type, "String") && value.addr) {
+		if (!(copy = strdup(value.addr)))
+			die("strdup:");
+		colors[SchemeNorm][ColBg] = copy;
+	}
+	if (XrmGetResource(database, "dmenu.foreground", "*", &type, &value)
+	&& !strcmp(type, "String") && value.addr) {
+		if (!(copy = strdup(value.addr)))
+			die("strdup:");
+		colors[SchemeNorm][ColFg] = copy;
+	}
+	if (XrmGetResource(database, "dmenu.selbackground", "*", &type, &value)
+	&& !strcmp(type, "String") && value.addr) {
+		if (!(copy = strdup(value.addr)))
+			die("strdup:");
+		colors[SchemeSel][ColBg] = copy;
+	}
+	if (XrmGetResource(database, "dmenu.selforeground", "*", &type, &value)
+	&& !strcmp(type, "String") && value.addr) {
+		if (!(copy = strdup(value.addr)))
+			die("strdup:");
+		colors[SchemeSel][ColFg] = copy;
+	}
+	if (XrmGetResource(database, "dmenu.hiforeground", "*", &type, &value)
+	&& !strcmp(type, "String") && value.addr) {
+		if (!(copy = strdup(value.addr)))
+			die("strdup:");
+		colors[SchemeNormHighlight][ColFg] = copy;
+	}
+	if (XrmGetResource(database, "dmenu.hibackground", "*", &type, &value)
+	&& !strcmp(type, "String") && value.addr) {
+		if (!(copy = strdup(value.addr)))
+			die("strdup:");
+		colors[SchemeNormHighlight][ColBg] = copy;
+	}
+	if (XrmGetResource(database, "dmenu.hiselforeground", "*", &type, &value)
+	&& !strcmp(type, "String") && value.addr) {
+		if (!(copy = strdup(value.addr)))
+			die("strdup:");
+		colors[SchemeSelHighlight][ColFg] = copy;
+	}
+	if (XrmGetResource(database, "dmenu.hiselbackground", "*", &type, &value)
+	&& !strcmp(type, "String") && value.addr) {
+		if (!(copy = strdup(value.addr)))
+			die("strdup:");
+		colors[SchemeSelHighlight][ColBg] = copy;
+	}
+	if (XrmGetResource(database, "dmenu.outforeground", "*", &type, &value)
+	&& !strcmp(type, "String") && value.addr) {
+		if (!(copy = strdup(value.addr)))
+			die("strdup:");
+		colors[SchemeOut][ColFg] = copy;
+	}
+	if (XrmGetResource(database, "dmenu.outbackground", "*", &type, &value)
+	&& !strcmp(type, "String") && value.addr) {
+		if (!(copy = strdup(value.addr)))
+			die("strdup:");
+		colors[SchemeOut][ColBg] = copy;
+	}
+	XrmDestroyDatabase(database);
+}
