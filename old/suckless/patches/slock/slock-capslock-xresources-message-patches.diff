+static int
+get_target_monitor(Display *dpy, Window root, const char *preferred_output,
+                   int *mx, int *my, int *mw, int *mh)
+{
+    XRRScreenResources *res = NULL;
+    XRROutputInfo *oi = NULL;
+    XRRCrtcInfo *ci = NULL;
+    RROutput primary;
+    int i, ok = 0;
+
+    *mx = *my = 0;
+    *mw = DisplayWidth(dpy, DefaultScreen(dpy));
+    *mh = DisplayHeight(dpy, DefaultScreen(dpy));
+
+    res = XRRGetScreenResourcesCurrent(dpy, root);
+    if (!res)
+        return 0;
+
+    primary = XRRGetOutputPrimary(dpy, root);
+
+    /* 1) Prefer an explicitly named output (e.g. "eDP-1") if provided */
+    if (preferred_output && preferred_output[0]) {
+        for (i = 0; i < res->noutput; i++) {
+            oi = XRRGetOutputInfo(dpy, res, res->outputs[i]);
+            if (!oi)
+                continue;
+
+            if (oi->crtc && oi->name && strcmp(oi->name, preferred_output) == 0) {
+                ci = XRRGetCrtcInfo(dpy, res, oi->crtc);
+                if (ci) {
+                    *mx = ci->x; *my = ci->y; *mw = ci->width; *mh = ci->height;
+                    ok = 1;
+                    XRRFreeCrtcInfo(ci);
+                }
+                XRRFreeOutputInfo(oi);
+                break;
+            }
+
+            XRRFreeOutputInfo(oi);
+        }
+    }
+
+    /* 2) Otherwise use the primary output */
+    if (!ok && primary) {
+        for (i = 0; i < res->noutput; i++) {
+            if (res->outputs[i] != primary)
+                continue;
+
+            oi = XRRGetOutputInfo(dpy, res, res->outputs[i]);
+            if (oi && oi->crtc) {
+                ci = XRRGetCrtcInfo(dpy, res, oi->crtc);
+                if (ci) {
+                    *mx = ci->x; *my = ci->y; *mw = ci->width; *mh = ci->height;
+                    ok = 1;
+                    XRRFreeCrtcInfo(ci);
+                }
+            }
+            if (oi) XRRFreeOutputInfo(oi);
+            break;
+        }
+    }
+
+    XRRFreeScreenResources(res);
+    return ok;
+}
+
+static void
+writemessage(Display *dpy, Window win, int screen)
+{
+    XftDraw *draw;
+    XftFont *font;
+    XftColor color;
+    Visual *visual;
+    Colormap cmap;
+    int x, y;
+    XGlyphInfo extents;
+
+    visual = DefaultVisual(dpy, screen);
+    cmap   = DefaultColormap(dpy, screen);
+
+    font = XftFontOpenName(dpy, screen, font_name);
+    if (!font)
+        return;
+
+    if (!XftColorAllocName(dpy, visual, cmap, text_color, &color)) {
+        XftFontClose(dpy, font);
+        return;
+    }
+
+    draw = XftDrawCreate(dpy, win, visual, cmap);
+
+    XftTextExtentsUtf8(
+        dpy, font,
+        (FcChar8 *)message,
+        strlen(message),
+        &extents
+    );
+
+    /* x = (DisplayWidth(dpy, screen) - extents.width) / 2; */
+    /* y = (DisplayHeight(dpy, screen) + extents.height) / 2; */
+
+    /* XWindowAttributes wa; */
+    /* XGetWindowAttributes(dpy, win, &wa); */
+    /* x = (wa.width  - extents.width)  / 2; */
+    /* y = (wa.height + extents.height) / 2; */
+
+    int mx, my, mw, mh;
+    Window root = RootWindow(dpy, screen);
+    get_target_monitor(dpy, root, NULL, &mx, &my, &mw, &mh);
+
+    x = mx + (mw - extents.width) / 2;
+    y = my + (mh + extents.height) / 2;
+
+    XftDrawStringUtf8(
+        draw, &color, font,
+        x, y,
+        (FcChar8 *)message,
+        strlen(message)
+    );
+
+    XftDrawDestroy(draw);
+    XftColorFree(dpy, visual, cmap, &color);
+    XftFontClose(dpy, font);
+}
 
